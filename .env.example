# Copy to .env.local and fill in.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Targeting (AI sales briefs) ──────────────────────────────────────────────
# Powers the "Research & generate script" button in Targeting — Claude searches
# the web for the lead and writes talking points, objections, and a closing
# strategy. Key from console.anthropic.com. In production, set this in your
# Vercel project's Environment Variables instead of committing it here.
ANTHROPIC_API_KEY=

# ─── Outreach (AI cold email) ────────────────────────────────────────────────
# Sends from your own mailbox over SMTP and reads replies over IMAP.
# Zoho (default for any non-Gmail address):
#   1. Zoho Mail > Settings > Mail Accounts > IMAP Access: enable it.
#   2. accounts.zoho.com > Security > App Passwords: generate one.
#   IMAP/SMTP need Zoho Mail Lite or higher; the Forever Free plan is web-only.
# Gmail also works: an address ending @gmail.com switches presets automatically.
# Uses ANTHROPIC_API_KEY above to write the emails.
EMAIL_USER=sadeeq@aisavvy.us
EMAIL_APP_PASSWORD=
# Zoho data center your account lives in: com (US), eu, in, com.au, jp, ca, sa.
ZOHO_REGION=com
# Override only for another provider (Outlook, your host, ...).
# SMTP_HOST=smtppro.zoho.com
# SMTP_PORT=465
# IMAP_HOST=imappro.zoho.com
# IMAP_PORT=993
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_TITLE=
OUTREACH_DAILY_LIMIT=25
# US anti-spam law (CAN-SPAM) requires a postal address in commercial email.
OUTREACH_POSTAL_ADDRESS=
# Protects /api/outreach/cron (checks replies + sends follow-ups). Any long
# random string; Vercel Cron sends it automatically when this is set.
CRON_SECRET=

# ─── Dialer (browser calling + live AI coach) ────────────────────────────────
# Twilio places the call and transcribes both sides in real time; Claude
# (ANTHROPIC_API_KEY above) suggests what to say. Calling is pay-as-you-go.
# In the Twilio Console:
#   1. Buy a phone number (Phone Numbers > Buy a number)      -> TWILIO_CALLER_ID
#   2. Account Info on the dashboard: Account SID + Auth Token -> first two below
#   3. Account > API keys & tokens > Create API key (Standard) -> SID + Secret
#   4. Voice > TwiML > TwiML Apps > Create: Voice Request URL =
#      https://YOUR-SITE/api/voice/twiml (HTTP POST)          -> TWILIO_TWIML_APP_SID
# NEXT_PUBLIC_SITE_URL above must be your live https URL (Twilio calls back to it).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

# ─── Scraper providers (all optional) ────────────────────────────────────────
# The built-in Sample source needs no keys, and Crawlee needs none either — it
# crawls the seed URLs you paste into the scrape form. Add a key below to unlock
# the matching source in the UI.

# Apollo.io — searches Apollo's people database directly by role and location.
# Email unlocks spend Apollo credits (capped per job). Key from your Apollo
# account under Settings > API.
APOLLO_API_KEY=

# Local businesses by search term and city. Requires a Google Cloud billing
# account on file (usage stays within the free monthly credit at this scale).
GOOGLE_MAPS_API_KEY=

# SerpApi — same idea as Google Maps above (local businesses by term + city),
# but via SerpApi's own infrastructure, so no Google Cloud billing account is
# needed. Free tier: 250 searches/month, no card required.
# Key from serpapi.com after signing up.
SERPAPI_KEY=

# Firecrawl — searches the open web, then extracts contacts. Best all-rounder.
# Get a key at firecrawl.dev, or point FIRECRAWL_API_URL at your own instance.
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=http://localhost:3002

# Crawl4AI — renders JavaScript-heavy sites. Runs as a local Docker container:
#   docker run -d -p 11235:11235 --shm-size=1g unclecode/crawl4ai:latest
# CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_URL=
# Required if your Crawl4AI server has auth enabled (the default since v0.9).
CRAWL4AI_TOKEN=

# Browser Use — AI agent that browses on its own. Slowest and most expensive.
# Key from cloud.browser-use.com.
BROWSER_USE_API_KEY=
# BROWSER_USE_MODEL=
